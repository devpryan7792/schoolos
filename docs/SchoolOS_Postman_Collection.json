              "raw": "{\n  \"absent_teacher_id\": \"00000000-0000-0000-0000-000000000101\",\n  \"day\": 1\n}"
            },
            "url": "{{baseUrl}}/v1/timetable/substitutions/auto-assign"
          }
        },
        {
          "name": "Tiered Notification Dispatch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": {\n    \"guardian_name\": \"Rajesh Sharma\",\n    \"phone_number\": \"+919876543210\",\n    \"push_token\": \"fcm_token_device_abc123\",\n    \"platform\": \"ANDROID\"\n  },\n  \"title\": \"Fee Reminder\",\n  \"body\": \"Your fee is due.\",\n  \"priority\": \"STANDARD\",\n  \"action_url\": \"https://schoolos.in/fees\"\n}"
            },
