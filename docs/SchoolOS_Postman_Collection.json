          }
        },
        {
          "name": "Computer Vision OMR 50-Q Evaluation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sheet_id\": \"omr-sheet-001\",\n  \"answer_key\": [\"A\",\"B\",\"C\",\"D\"]\n}"
            },
            "url": "{{baseUrl}}/v1/omr/evaluate"
          }
        }
      ]
    }
  ]
}
