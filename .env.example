# ==============================================================================
# SchoolOS Master Production & Local Environment Configuration
# Copy this to .env or load directly into Vercel / Railway / Docker.
# ==============================================================================

# --- 1. CORE SERVER SETTINGS ---
PORT=8080
GIN_MODE=release
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- 2. MANAGED POSTGRESQL (Supabase / Neon / Local Docker) ---
# For local development via docker-compose:
DATABASE_URL=postgres://schoolos_app:schoolos_app_secret@localhost:5432/schoolos?sslmode=disable
# For Production Supabase / Neon:
# DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Superuser URL for migrations (bypasses RLS during schema setup)
DATABASE_SUPERUSER_URL=postgres://postgres:postgres_dev_secret@localhost:5432/schoolos?sslmode=disable

# --- 3. MANAGED REDIS (Upstash Serverless / Local Docker) ---
# For local development via docker-compose:
REDIS_URL=redis://localhost:6379/0
# For Production Upstash:
# REDIS_URL=rediss://default:[YOUR-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379

# --- 4. OBJECT STORAGE (Cloudflare R2 / AWS S3 / Local MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=schoolos-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_REGION=auto
# For Cloudflare R2:
# S3_ENDPOINT=https://[ACCOUNT-ID].r2.cloudflarestorage.com
# S3_BUCKET=schoolos-prod
# S3_ACCESS_KEY=[R2-ACCESS-KEY]
# S3_SECRET_KEY=[R2-SECRET-KEY]

# --- 5. SECURITY & JWT AUTHENTICATION ---
JWT_SECRET=replace_this_with_a_secure_random_64_char_secret_key_in_production
SESSION_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.schoolos.in

# --- 6. ERROR MONITORING & TELEMETRY (Sentry Free Tier) ---
# SENTRY_DSN=https://[KEY]@[HOST]/[PROJECT_ID]
# NEXT_PUBLIC_SENTRY_DSN=https://[KEY]@[HOST]/[PROJECT_ID]

# --- 7. HARDWARE IOT & FLEET (TCP Port 5023) ---
TCP_TELEMETRY_PORT=5023

# --- 8. WHATSAPP META CLOUD API (1,000 Free Conversations / Month) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=schoolos_wa_verify_token_prod_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- 9. TELECOM SMS DLT GATEWAY (Tier 3 Fallback) ---
SMS_GATEWAY_PROVIDER=mock
# SMS_GATEWAY_API_KEY=
# SMS_GATEWAY_SENDER_ID=SCHLOS
